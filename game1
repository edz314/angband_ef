async function callLLM(promptData) {
  const controller = new AbortController();
  const timeoutId = setTimeout(() => controller.abort(), 10000); // 10s timeout

  try {
    const res = await fetch('http://localhost:11434/api/generate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ model: 'llama3.1:8b', prompt: buildPrompt(promptData), stream: false }),
      signal: controller.signal
    });
    clearTimeout(timeoutId);

    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    const data = await res.json();
    return parseLLMResponse(data.response, promptData.template);
  } catch (err) {
    console.warn('LLM fallback triggered:', err.message);
    return loadFallback(promptData.template); // Returns static JSON array/object
  }
}
